{
  "name": "japa-advertising-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:api": "newman run full_test_suite.postman_collection.json",
    "test:html": "newman run full_test_suite.postman_collection.json -r htmlextra",
    "check": "node --test tests/unit/syntax.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mysql-session": "^2.1.8",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.9.7",
    "xss-clean": "^0.1.4"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
