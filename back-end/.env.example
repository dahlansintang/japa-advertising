# Salin file ini menjadi .env lalu isi sesuai lingkungan lokal.
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_japa_advertising

# Buat secret acak minimal 32 karakter. Jangan commit nilai aslinya.
SESSION_SECRET=

# Pisahkan beberapa origin dengan koma jika frontend di-host terpisah.
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
