  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const unsafeMethods = ['POST', 'PUT', 'PATCH', 'DELETE'];",
          "const skipAutoCsrf = pm.request.headers.get('X-Skip-CSRF-Auto') === 'true';",
          "if (unsafeMethods.includes(pm.request.method.toUpperCase()) && !skipAutoCsrf) {",
          "    const baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:3000';",
          "    pm.sendRequest({",
          "        url: baseUrl.replace(/\\/$/, '') + '/api/auth/csrf',",
          "        method: 'GET',",
          "        header: { 'Accept': 'application/json' }",
          "    }, function (err, response) {",
          "        if (err) {",
          "            throw new Error('Gagal mengambil CSRF token: ' + err);",
          "        }",
          "        if (!response || response.code < 200 || response.code >= 300) {",
          "            throw new Error('Endpoint CSRF gagal. HTTP ' + (response ? response.code : 'tanpa respons'));",
          "        }",
          "        let body;",
          "        try { body = response.json(); } catch (e) { throw new Error('Respons endpoint CSRF bukan JSON yang valid.'); }",
          "        const token = body.csrfToken || body.csrf_token || body.token ||",
          "            (body.data && (body.data.csrfToken || body.data.csrf_token || body.data.token));",
          "        if (!token || typeof token !== 'string') {",
          "            throw new Error('Token CSRF tidak ditemukan. Sesuaikan nama properti dengan respons GET /api/auth/csrf.');",
          "        }",
          "        pm.collectionVariables.set('csrfToken', token);",
          "        pm.request.headers.upsert({ key: 'X-CSRF-Token', value: token });",
          "    });",
          "}"
        ]
      }
    }
  ]
