  "item": [
    {
      "name": "TC-CSRF-01: Ambil CSRF Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/csrf",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "csrf"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Endpoint CSRF mengembalikan HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Respons menyediakan token CSRF', function () {",
              "    const body = pm.response.json();",
              "    const token = body.csrfToken || body.csrf_token || body.token ||",
              "        (body.data && (body.data.csrfToken || body.data.csrf_token || body.data.token));",
              "    pm.expect(token, 'Properti token pada respons GET /api/auth/csrf').to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('csrfToken', token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-CSRF-02: Request Mutasi Tanpa Token Ditolak",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Skip-CSRF-Auto",
            "value": "true"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama_lengkap\": \"Uji CSRF Tanpa Token\",\n  \"email\": \"csrf_missing_token_{{timestamp}}@test.com\",\n  \"password\": \"PasswordValid123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('timestamp', Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request tanpa CSRF token ditolak', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([403, 419]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-CSRF-03: Request Mutasi dengan Token Tidak Valid Ditolak",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Skip-CSRF-Auto",
            "value": "true"
          },
          {
            "key": "X-CSRF-Token",
            "value": "token-tidak-valid-untuk-pengujian"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama_lengkap\": \"Uji CSRF Token Tidak Valid\",\n  \"email\": \"csrf_invalid_token_{{timestamp}}@test.com\",\n  \"password\": \"PasswordValid123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('timestamp', Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request dengan CSRF token tidak valid ditolak', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([403, 419]);",
              "});"
            ]
          }
        }
      ]
    },
